<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="EncryptionDesktop.Views.LicenseGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:EncryptionDesktop.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:LicenseGeneratorViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            MaxWidth="1000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="License Generator" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

                <!--  License information  -->
                <Border
                    Grid.Column="0"
                    Padding="20"
                    BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="18">

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="License information" />

                        <TextBox
                            Header="Customer:"
                            PlaceholderText="Company name"
                            Text="{Binding Customer, Mode=TwoWay}" />

                        <TextBox
                            Header="Product:"
                            PlaceholderText="Enter product name"
                            Text="{Binding Product, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox
                                Header="License ID:"
                                IsReadOnly="True"
                                Text="{Binding LicenseId}" />

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{Binding GenerateNewLicenseIdCommand}"
                                Content="New ID" />
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="License type:" />

                            <RadioButtons SelectedIndex="{Binding SelectedLicenseType, Mode=TwoWay}">
                                <RadioButton Content="Permanent license" />
                                <RadioButton Content="Time-limited license" />
                            </RadioButtons>
                        </StackPanel>

                        <DatePicker
                            Date="{Binding ExpiryDate, Mode=TwoWay}"
                            Header="Expiration date:"
                            IsEnabled="{Binding IsExpiryDateEnabled}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding GenerateLicenseCommand}"
                                Content="Generate License" />

                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{Binding VerifyLicenseCommand}"
                                Content="Verify License" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  RSA keys  -->
                <Border
                    Grid.Column="1"
                    Padding="20"
                    BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel Spacing="18">

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="RSA keys" />

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox
                                Width="270"
                                Header="Save folder:"
                                IsReadOnly="True"
                                Text="{Binding DisplayFolder}"
                                TextWrapping="NoWrap">

                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{Binding SelectedFolder}" />
                                </ToolTipService.ToolTip>
                            </TextBox>

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{Binding CopyFolderPathCommand}">
                                <SymbolIcon Symbol="{Binding CopyPathIcon}" />
                            </Button>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{Binding SelectFolderCommand}"
                                Content="Browse..." />
                        </Grid>

                        <PasswordBox Header="Encryption password:" PasswordChanged="EncryptionPasswordBox_PasswordChanged" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding GenerateKeysCommand}"
                            Content="Generate RSA Keys" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding DecodeLicenseCommand}"
                            Content="Decode License" />

                        <TextBox
                            Width="400"
                            MinHeight="100"
                            MaxHeight="200"
                            AcceptsReturn="True"
                            Header="License payload:"
                            Text="{Binding LicenseContent, Mode=TwoWay}"
                            TextWrapping="Wrap" />

                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding ModifyLicenseCommand}"
                            Content="Modify License" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox
                                MaxWidth="300"
                                Header="License file:"
                                IsReadOnly="True"
                                Text="{Binding DisplayLicensePath}"
                                TextWrapping="NoWrap">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{Binding SelectedLicensePath}" />
                                </ToolTipService.ToolTip>
                            </TextBox>

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{Binding SelectLicenseFileCommand}"
                                Content="Browse..." />
                        </Grid>

                    </StackPanel>
                </Border>

            </Grid>

            <InfoBar
                Height="50"
                IsClosable="False"
                IsOpen="{Binding InfoBarIsOpen}"
                Message="{Binding ResultStatus}"
                Severity="{Binding InfoBarSeverity}" />

        </StackPanel>
    </Grid>
</Page>